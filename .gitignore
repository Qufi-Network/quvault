node_modules/
data/
.env
wallet-seed.txt

# Android / Bubblewrap TWA build. The signing key and its password never go in git;
# the keystore is the app's identity and must be kept and backed up out of band.
android/*.keystore
android/signing.env
# Bubblewrap build output and the generated Android project (regenerated by `bubblewrap build`).
*.apk
*.aab
app/
.gradle/
android/app/
twa-manifest.json.lock

# test/migrate.test.js writes a past version of db.js beside the current one so its relative
# imports resolve, and removes it in a finally. A crashed run leaves one behind.
src/_replay_*.js
