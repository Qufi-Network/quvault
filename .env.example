# Copy to .env and fill in. `npm run keygen` prints a WALLET_SEED.

PORT=4970
PUBLIC_ORIGIN=http://localhost:4970

# Veyns sandbox application (developer console) — register this exact origin and origin + "/".
VEYNS_ISSUER=https://sandbox.id.veyns.io
VEYNS_CLIENT_ID=
# Backend credential. Required: wallet creation and every withdrawal need a palm approval.
VEYNS_BACKEND_SECRET=
# true: only palm sign-in is accepted (palm is always required for spending, either way).
REQUIRE_PALM_SIGNIN=false

# Seals every wallet key with ML-KEM-768 + X25519 + AES-256-GCM. Keep it, and keep it secret.
WALLET_SEED=

BITCOIN_NETWORK=testnet4
CHAIN_API=https://mempool.space/testnet4/api

# Optional: a Postgres URL. Without it, data lives in data/pgdata (PGlite).
QUVAULT_DATABASE_URL=
