# Copy to .env and fill in. `npm run keygen` prints a WALLET_SEED.

PORT=4970
PUBLIC_ORIGIN=http://localhost:4970

# Veyns sandbox application (developer console) — register this exact origin and origin + "/".
VEYNS_ISSUER=https://sandbox.id.veyns.io
VEYNS_CLIENT_ID=
# Backend credential. Required: wallet creation and every withdrawal need a palm approval.
VEYNS_BACKEND_SECRET=
# true: only palm sign-in is accepted (palm is always required for spending, either way).
REQUIRE_PALM_SIGNIN=false

# Seals the one-time unlock secrets with ML-KEM-768 + X25519 + AES-256-GCM, and anchors the
# attestation roots. It does NOT hold a wallet key: those are generated in the browser and
# never sent here. Keep it, and keep it secret.
WALLET_SEED=

# Leave unset. Only a process migrating pre-v3 server-custody wallets needs this; without it,
# nothing served by the app can open a legacy private key at all.
QUVAULT_LEGACY_SEED=

# Where signed evidence checkpoints are retained OUTSIDE this deployment. Without one there is
# no durable external anchor: a rewrite of the whole database would leave nothing to contradict
# it except a browser that happens to remember. The URL must belong to whoever retains the
# evidence — the customer, their auditor, a write-once store under their key — not to whoever
# runs this service. See CHECKPOINTING.md.
QUVAULT_ANCHOR_URL=
QUVAULT_ANCHOR_TOKEN=
# Set true if the sink above is somewhere YOU control. It is then a backup rather than an
# independent anchor, and the status will report it that way instead of claiming otherwise.
QUVAULT_ANCHOR_OPERATOR_CONTROLLED=false

BITCOIN_NETWORK=testnet4
CHAIN_API=https://mempool.space/testnet4/api

# Optional: a Postgres URL. Without it, data lives in data/pgdata (PGlite).
QUVAULT_DATABASE_URL=
