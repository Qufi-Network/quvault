{
  "name": "quvault",
  "version": "0.1.0",
  "private": true,
  "description": "A testnet4 Bitcoin wallet whose key is sealed post-quantum and whose withdrawals need a Veyns palm approval.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node scripts/ids.js && node --test \"test/*.test.js\"",
    "keygen": "node scripts/keygen.js",
    "check": "node scripts/check.js",
    "build:client": "esbuild client/wallet.js --bundle --format=esm --minify --target=es2022 --outfile=public/vendor/wallet.js",
    "audit": "node scripts/audit.js",
    "inventory": "node scripts/legacy-inventory.js"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@noble/post-quantum": "^0.7.1",
    "@scure/base": "^1.2.6",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.6.0",
    "@scure/btc-signer": "^1.8.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@stellar/stellar-base": "^15.0.0",
    "esbuild": "^0.28.2"
  }
}
